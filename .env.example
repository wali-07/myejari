# MyEjari — environment variables template
#
# Copy this file to `.env.local` for local dev, OR add the same keys in Vercel
# Project → Settings → Environment Variables for production. Never commit
# real values.

# ─── Google Places API (optional) ─────────────────────────────────────────
# When BOTH of these are set, the homepage live-fetches reviews from Google
# every 24h. When either is missing the site falls back to the curated list
# in src/lib/reviews.ts (currently 21 reviews) — no degraded UX either way.
#
# Find your Place ID at:
#   https://developers.google.com/maps/documentation/places/web-service/place-id
#
# The API key needs the Places API enabled in Google Cloud Console.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=

# ─── Canonical site URL (per-environment override) ────────────────────────
# Set this on staging deployments so OG images, canonical tags, and JSON-LD
# all resolve to the live host (e.g. https://myejari-web.vercel.app) instead
# of the .ae production domain. Leave unset (or set to https://myejari.ae)
# on the production deployment after DNS cutover.
#   - Trailing slash optional; the code strips it.
#   - Must include the protocol (https://).
NEXT_PUBLIC_SITE_URL=

# ─── Admin auth ───────────────────────────────────────────────────────────
# Single-account email/password gate for /admin/*. The middleware verifies a
# signed session cookie; sign-in happens at /admin/login. Defaults below
# match the local-dev convenience values baked into src/lib/admin/auth.ts —
# you MUST override these for production via Vercel env vars before deploy.
ADMIN_EMAIL=admin@myejari.com
ADMIN_PASSWORD=Ejari123!!!
# 32+ random bytes recommended in production. The local default is fine for
# dev. Run `openssl rand -base64 48` to generate a proper secret.
SESSION_SECRET=change-me-in-production

# ─── Google Tag Manager (optional) ────────────────────────────────────────
# Defaults to MyEjari's existing container (GTM-MBSNLQ4L) if unset, which
# already routes GA4 (G-KG7L9EK7H9) and the Google Ads WhatsApp-click
# conversion (16933501253 / OA1zCJONsasaEMXywoo_) via the api.whatsapp.com
# Click URL trigger. Override here only if a different container is in play.
NEXT_PUBLIC_GTM_ID=GTM-MBSNLQ4L
