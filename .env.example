# MyEjari — environment variables template
#
# Copy this file to `.env.local` for local dev, OR add the same keys in Vercel
# Project → Settings → Environment Variables for production. Never commit
# real values.

# ─── Google Places API (optional) ─────────────────────────────────────────
# When BOTH of these are set, the homepage live-fetches reviews from Google
# every 24h. When either is missing the site falls back to the curated list
# in src/lib/reviews.ts (currently 21 reviews) — no degraded UX either way.
#
# Find your Place ID at:
#   https://developers.google.com/maps/documentation/places/web-service/place-id
#
# The API key needs the Places API enabled in Google Cloud Console.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=

# ─── Google Tag Manager (optional) ────────────────────────────────────────
# Defaults to MyEjari's existing container (GTM-MBSNLQ4L) if unset, which
# already routes GA4 (G-KG7L9EK7H9) and the Google Ads WhatsApp-click
# conversion (16933501253 / OA1zCJONsasaEMXywoo_) via the api.whatsapp.com
# Click URL trigger. Override here only if a different container is in play.
NEXT_PUBLIC_GTM_ID=GTM-MBSNLQ4L
